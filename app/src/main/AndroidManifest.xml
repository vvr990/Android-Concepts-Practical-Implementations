<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidConcepts">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AndroidConcepts"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".activitylifecycle.ActivityLifecycleDemo"
            android:exported="false" />

        <activity
            android:name=".service.foreground.ForegroundServiceDemo"
            android:exported="false"/>

        <activity
            android:name=".service.background.BackgroundServiceDemo"
            android:exported="false"/>

        <activity
            android:name=".service.bound.BoundServiceDemo"
            android:exported="false"/>

        <activity
            android:name=".intent.explicit.ExplicitIntentDemo"
            android:exported="false" />

        <activity
            android:name=".intent.explicit.SecondActivity"
            android:exported="false" />

        <activity
            android:name=".intent.implicit.ImplicitIntentDemo"
            android:exported="false" />

        <service
            android:name=".service.foreground.ForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".service.background.BackgroundService"
            android:exported="false" />

        <service
            android:name=".service.bound.BoundService"
            android:exported="false" />

    </application>

</manifest>